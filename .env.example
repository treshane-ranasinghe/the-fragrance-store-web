# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public site address (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret: must match private.app_config 'revalidate_secret' in the database
REVALIDATE_SECRET=change-me-to-a-long-random-string

# Optional: order emails via Resend
RESEND_API_KEY=
EMAIL_FROM="The Fragrance Store <orders@thefragrancestore.lk>"
